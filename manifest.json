
{
  "manifest_version": 3,
  "name": "forceJump",
  "version": "1.1.0",
  "description": "Bypass redirect warning pages and open external links directly.",
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "images/icon16.png",
      "24": "images/24x24.png",
      "32": "images/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://*.csdn.net/*",
        "https://*.juejin.cn/*",
        "https://*.jianshu.com/*",
        "https://*.zhihu.com/*"
      ],
      "js": ["scripts/settings.js", "scripts/content.js"],
      "run_at": "document_idle"
    }
  ]
}
